// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// AUTHENTICATION & USER MANAGEMENT
// ================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(STAFF)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts          Account[]
  sessions          Session[]
  donors            Donor[]         @relation("DonorManager")
  assignedConvos    Conversation[]  @relation("InboxAssignee")
  sentMessages      Message[]       @relation("MessageSender")

  @@index([email])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ================================
// DONOR MANAGEMENT
// ================================

model Donor {
  id                    String      @id @default(cuid())
  fullName              String
  isAnonymous           Boolean     @default(false)
  anonymousCode         String?     // Mạnh thường quân 01, 02,...
  email                 String?
  phone                 String?
  address               String?
  type                  DonorType
  tier                  DonorTier   @default(NEW)
  occupation            String?
  company               String?
  position              String?
  birthday              DateTime?
  firstDonationDate     DateTime?
  personalInterests     String?
  areasOfInterest       String[]    @default([])
  notes                 String?
  isPatient             Boolean     @default(false)
  isPatientFamily       Boolean     @default(false)
  contactMethod         String?     // Ví dụ: Zalo, Facebook, Phone
  contactName           String?     // Tên tài khoản liên lạc

  // Lead tracking
  leadStatus            LeadStatus?           // null = đã là donor thực sự
  leadSource            LeadSource?           // Nguồn tiếp cận
  leadNote              String?               // Ghi chú tiếp cận
  convertedAt           DateTime?             // Ngày chuyển đổi thành donor

  // Manager relationship
  managerId             String?
  manager               User?       @relation("DonorManager", fields: [managerId], references: [id])

  // Relations
  cashDonations         DonationCash[]
  inKindDonations       DonationInKind[]
  volunteerDonations    DonationVolunteer[]
  interactions          Interaction[]
  emailLogs             EmailLog[]
  reminders             Reminder[]

  // Cancer Support Relations
  medicationSponsors    MedicationSponsor[]
  patientTreatments     PatientTreatment[]

  // Contracts
  contracts             Contract[]

  // Inbox conversations
  conversations         Conversation[]

  // Inactive Sponsor Notifications
  inactiveNotifications InactiveSponsorNotification[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  @@index([email])
  @@index([phone])
  @@index([fullName])
  @@index([type])
  @@index([tier])
  @@index([managerId])
  @@index([leadStatus])
  @@map("donors")
}

enum LeadStatus {
  NEW           // Mới tiếp cận
  CONTACTED     // Đã liên hệ
  INTERESTED    // Quan tâm
  NEGOTIATING   // Đang thương lượng
  CONVERTED     // Đã chuyển đổi thành donor
  LOST          // Không chuyển đổi được
}

enum LeadSource {
  FACEBOOK      // Facebook
  ZALO          // Zalo
  REFERRAL      // Giới thiệu
  EVENT         // Sự kiện
  WEBSITE       // Website
  COLD_CALL     // Gọi trực tiếp
  OTHER         // Khác
}

enum DonorType {
  INDIVIDUAL    // Cá nhân
  COMPANY       // Doanh nghiệp
  ORGANIZATION  // Tổ chức
  COMMUNITY     // Nhóm/Cộng đồng
}

enum DonorTier {
  VIP           // VIP
  REGULAR       // Thường xuyên
  NEW           // Mới
  POTENTIAL     // Tiềm năng
}

// ================================
// DONATION MANAGEMENT
// ================================

// Tài trợ tiền mặt
model DonationCash {
  id              String              @id @default(cuid())
  donorId         String
  donor           Donor               @relation(fields: [donorId], references: [id], onDelete: Cascade)

  amount          Decimal             @db.Decimal(15, 2)
  currency        Currency            @default(VND)
  paymentMethod   PaymentMethod
  receivedDate    DateTime
  purpose         String              // Dropdown mục đích
  purposeOther    String?             // Nếu chọn "Khác" thì nhập ở đây
  receiptUrl      String?
  status          DonationStatus      @default(COMMITTED)

  // Quản lý tiền
  custodian       String              @default("Uỷ quyền cho phòng CTXH")  // Ai đang giữ tiền
  voucherCode     String?             // Mã phiếu thu / mã lệnh chuyển khoản (khi kế toán giữ)

  // Tình trạng sử dụng (multi-item)
  usedAmount      Decimal             @default(0) @db.Decimal(15, 2)  // Tổng đã sử dụng (tính tự động)
  usageItems      Json                @default("[]")  // [{description, amount}]
  usageNote       String?             // Ghi chú tình trạng sử dụng

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([donorId])
  @@index([receivedDate])
  @@index([status])
  @@map("donation_cash")
}

enum Currency {
  VND
  USD
  EUR
}

enum PaymentMethod {
  CASH            // Tiền mặt
  BANK_TRANSFER   // Chuyển khoản
  E_WALLET        // Ví điện tử
}

enum CashCustodian {
  CTXH            // Uỷ quyền cho phòng CTXH
  ACCOUNTING      // Kế toán giữ tiền
  STAFF           // Nhân viên CTXH đang giữ (Minh Lan)
}

enum DonationStatus {
  COMMITTED       // Cam kết
  RECEIVED        // Nhận
  IN_USE          // Sử dụng
  REPORTED        // Báo cáo
}

// Tài trợ hiện vật
model DonationInKind {
  id                    String                      @id @default(cuid())
  donorId               String
  donor                 Donor                       @relation(fields: [donorId], references: [id], onDelete: Cascade)

  itemName              String
  category              InKindCategory
  quantity              Int
  unit                  String
  condition             ItemCondition               @default(NEW)
  expiryDate            DateTime?
  estimatedValue        Decimal?                    @db.Decimal(15, 2)
  imageUrls             String[]                    @default([])
  receivingLocation     String
  storageLocation       String
  distributionStatus    DistributionStatus          @default(PENDING)

  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?

  @@index([donorId])
  @@index([category])
  @@index([distributionStatus])
  @@map("donation_in_kind")
}

enum InKindCategory {
  MEDICAL_EQUIPMENT     // Thiết bị y tế
  MEDICINE              // Thuốc
  SUPPLIES              // Đồ dùng
  FOOD                  // Thực phẩm
  OTHER                 // Khác
}

enum ItemCondition {
  NEW                   // Mới
  USED                  // Đã qua sử dụng
}

enum DistributionStatus {
  PENDING               // Chờ nhận
  RECEIVED              // Đã nhận
  DISTRIBUTED           // Đã phân phối
}

// Công tác xã hội tình nguyện
model DonationVolunteer {
  id                    String                  @id @default(cuid())
  donorId               String
  donor                 Donor                   @relation(fields: [donorId], references: [id], onDelete: Cascade)

  workType              VolunteerWorkType
  skills                String
  startDate             DateTime
  endDate               DateTime
  hours                 Decimal                 @db.Decimal(10, 2)
  hourlyRate            Decimal                 @db.Decimal(10, 2)  // Giá trị quy đổi/giờ
  totalValue            Decimal                 @db.Decimal(15, 2)  // Tổng giá trị quy đổi
  rating                Int?                                        // 1-5 stars
  reviewNotes           String?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?

  @@index([donorId])
  @@index([workType])
  @@index([startDate])
  @@map("donation_volunteer")
}

enum VolunteerWorkType {
  MEDICAL               // Y tế
  ADMINISTRATIVE        // Hành chính
  TRANSPORTATION        // Vận chuyển
  CARE                  // Chăm sóc
  OTHER                 // Khác
}

// ================================
// INTERACTION MANAGEMENT
// ================================

model Interaction {
  id              String              @id @default(cuid())
  donorId         String
  donor           Donor               @relation(fields: [donorId], references: [id], onDelete: Cascade)

  type            InteractionType
  date            DateTime
  content         String

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([donorId])
  @@index([date])
  @@index([type])
  @@map("interactions")
}

enum InteractionType {
  CALL                  // Cuộc gọi
  EMAIL                 // Email
  MEETING               // Gặp mặt
  EVENT                 // Sự kiện
}

// ================================
// GRATITUDE MODULE
// ================================

model EmailLog {
  id              String          @id @default(cuid())
  donorId         String
  donor           Donor           @relation(fields: [donorId], references: [id], onDelete: Cascade)

  templateId      String?
  template        EmailTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  subject         String
  body            String
  sentAt          DateTime        @default(now())
  status          EmailStatus     @default(PENDING)
  errorMessage    String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([donorId])
  @@index([templateId])
  @@index([sentAt])
  @@map("email_logs")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailTemplate {
  id              String          @id @default(cuid())
  name            String
  subject         String
  body            String
  type            TemplateType    @default(OTHER)

  emailLogs       EmailLog[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([type])
  @@map("email_templates")
}

enum TemplateType {
  THANK_YOU         // Cảm ơn
  BIRTHDAY          // Sinh nhật
  REPORT            // Báo cáo
  RECONNECT         // Kết nối lại
  OTHER             // Khác
}

model Reminder {
  id              String          @id @default(cuid())
  donorId         String
  donor           Donor           @relation(fields: [donorId], references: [id], onDelete: Cascade)

  type            ReminderType
  dueDate         DateTime
  title           String
  description     String?
  isCompleted     Boolean         @default(false)
  completedAt     DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([donorId])
  @@index([dueDate])
  @@index([isCompleted])
  @@index([type])
  @@map("reminders")
}

enum ReminderType {
  BIRTHDAY              // Sinh nhật
  DONATION_ANNIVERSARY  // Kỷ niệm tài trợ
  SEND_REPORT           // Gửi báo cáo
  FOLLOW_UP             // Theo dõi
  OTHER                 // Khác
}

// ================================
// CANCER SUPPORT PROGRAM
// ================================

// Bệnh nhân ung thư
model CancerPatient {
  id                    String                  @id @default(cuid())
  patientCode           String                  @unique
  name                  String
  gender                PatientGender
  yearOfBirth           Int
  phone                 String?
  cccd                  String?
  status                PatientStatus           @default(ACTIVE)

  // Trạng thái phụ (dùng để thống kê)
  subStatus             PatientSubStatus?

  // Relations
  treatments            PatientTreatment[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?

  @@index([patientCode])
  @@index([name])
  @@index([status])
  @@index([subStatus])
  @@map("cancer_patients")
}

enum PatientGender {
  MALE                  // Nam
  FEMALE                // Nữ
  OTHER                 // Khác
}

enum PatientStatus {
  ACTIVE                // Đang điều trị
  DECEASED              // Tử vong
  LOST_CONTACT          // Mất liên lạc
  TRANSFERRED_OUT       // Chuyển đi viện khác
  DISCONTINUED          // Ngừng tham gia
}

enum PatientSubStatus {
  CHANGED_MEDICATION    // Đổi thuốc
  CONCURRENT_TREATMENT  // Điều trị song song
  TRANSFERRED_IN        // Chuyển từ viện khác tới
  REJOINED              // Tham gia lại
}

// Thuốc
model Medication {
  id                    String                  @id @default(cuid())
  name                  String
  description           String?
  unitPrice             Decimal                 @db.Decimal(15, 2)
  cycleDays             Int                     // Chu kỳ bao nhiêu ngày
  sponsorPolicy         SponsorPolicy           // Chính sách tài trợ

  // Relations
  sponsors              MedicationSponsor[]     // Nhiều nhà tài trợ
  treatments            PatientTreatment[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?

  @@index([name])
  @@map("medications")
}

enum SponsorPolicy {
  BUY_1_GET_1           // Mua 1 tặng 1
  BUY_2_GET_1           // Mua 2 tặng 1
  BUY_3_GET_1           // Mua 3 tặng 1
  FULL_SPONSOR          // Tài trợ 100%
}

// Quan hệ nhiều-nhiều: Thuốc <-> Nhà tài trợ
model MedicationSponsor {
  id                    String                  @id @default(cuid())
  medicationId          String
  medication            Medication              @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  sponsorId             String
  sponsor               Donor                   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  isActive              Boolean                 @default(true)

  createdAt             DateTime                @default(now())

  @@unique([medicationId, sponsorId])
  @@index([medicationId])
  @@index([sponsorId])
  @@map("medication_sponsors")
}

// Lịch sử điều trị
model PatientTreatment {
  id                    String                  @id @default(cuid())
  patientId             String
  patient               CancerPatient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  medicationId          String
  medication            Medication              @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  cycleNumber           Int                     // Chu kỳ thứ mấy
  treatmentDate         DateTime                // Ngày thực hiện
  nextCycleDate         DateTime                // Ngày chu kỳ tiếp theo (tự động tính)

  isSponsored           Boolean                 @default(false)  // Có được tài trợ không
  sponsorId             String?                 // Công ty tài trợ
  sponsor               Donor?                  @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  donationAmount        Decimal?                @db.Decimal(15, 2)  // Số tiền quyên góp

  status                TreatmentStatus         @default(UPCOMING)
  notes                 String?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?

  @@index([patientId])
  @@index([medicationId])
  @@index([treatmentDate])
  @@index([nextCycleDate])
  @@index([status])
  @@map("patient_treatments")
}

enum TreatmentStatus {
  UPCOMING              // Sắp đến
  COMPLETED             // Hoàn thành
  CANCELLED             // Hủy
}

// ================================
// CONTRACT MANAGEMENT
// ================================

model Contract {
  id                String          @id @default(cuid())
  contractNumber    String          @unique  // Số hợp đồng
  donorId           String
  donor             Donor           @relation(fields: [donorId], references: [id], onDelete: Cascade)

  signedDate        DateTime        // Ngày ký
  startDate         DateTime        // Ngày hiệu lực
  endDate           DateTime?       // Ngày hết hạn (null = vô thời hạn)

  committedAmount   Decimal         @db.Decimal(15, 2)  // Giá trị cam kết
  currency          Currency        @default(VND)

  purpose           String          // Mục đích hợp đồng
  terms             String?         // Điều khoản
  fileUrl           String?         // File hợp đồng PDF

  status            ContractStatus  @default(ACTIVE)
  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([donorId])
  @@index([status])
  @@index([endDate])
  @@map("contracts")
}

enum ContractStatus {
  ACTIVE            // Đang hiệu lực
  EXPIRED           // Hết hạn
  TERMINATED        // Đã thanh lý
  DRAFT             // Nháp
}

// ================================
// INACTIVE SPONSOR NOTIFICATIONS
// ================================

// Thông báo nhà tài trợ không hoạt động
model InactiveSponsorNotification {
  id                    String                  @id @default(cuid())
  donorId               String
  donor                 Donor                   @relation(fields: [donorId], references: [id], onDelete: Cascade)

  lastDonationDate      DateTime?               // Ngày tài trợ cuối cùng
  notifiedAt            DateTime                @default(now())  // Ngày thông báo
  isResolved            Boolean                 @default(false)  // Đã xử lý chưa
  resolvedAt            DateTime?               // Ngày xử lý

  // Lịch sử liên hệ
  contactHistory        SponsorContactHistory[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([donorId])
  @@index([isResolved])
  @@index([notifiedAt])
  @@map("inactive_sponsor_notifications")
}

// Lịch sử liên hệ với nhà tài trợ
model SponsorContactHistory {
  id                    String                          @id @default(cuid())
  notificationId        String
  notification          InactiveSponsorNotification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  contactNumber         Int                             // Lần liên hệ thứ mấy (1, 2, 3,...)
  contactDate           DateTime                        @default(now())  // Ngày liên hệ
  notes                 String?                         // Ghi chú

  createdAt             DateTime                        @default(now())

  @@index([notificationId])
  @@map("sponsor_contact_history")
}

// ================================
// FANPAGE MODULE
// ================================

model FanpagePost {
  id              String            @id @default(cuid())
  title           String            // Tiêu đề/mô tả nội dung bài
  scheduledAt     DateTime          // Ngày giờ dự kiến đăng
  content         String?           // Nội dung bài viết
  imageUrl        String?

  status          FanpagePostStatus @default(SCHEDULED)
  notified7Days   Boolean           @default(false)  // Đã gửi thông báo trước 7 ngày chưa
  notifiedDay     Boolean           @default(false)  // Đã gửi thông báo ngày đăng chưa

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([status])
  @@map("fanpage_posts")
}

enum FanpagePostStatus {
  SCHEDULED     // Đã lên lịch
  PUBLISHED     // Đã đăng
  CANCELLED     // Huỷ
}

// ================================
// UNIFIED INBOX
// ================================

// Một cuộc hội thoại qua bất kỳ kênh nào
model Conversation {
  id              String              @id @default(cuid())

  channel         InboxChannel        // Kênh: Facebook, Zalo, Email...
  externalId      String              // ID cuộc trò chuyện bên ngoài (thread_id, conversation_id)
  externalUserId  String              // ID người dùng bên ngoài (page-scoped ID, Zalo user ID...)
  displayName     String?             // Tên người dùng bên ngoài
  avatarUrl       String?             // Avatar người dùng

  // Link với donor nếu đã nhận diện được
  donorId         String?
  donor           Donor?              @relation(fields: [donorId], references: [id], onDelete: SetNull)

  // Phân công cho staff
  assignedToId    String?
  assignedTo      User?               @relation("InboxAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  status          ConversationStatus  @default(OPEN)
  lastMessageAt   DateTime            @default(now())
  isRead          Boolean             @default(false)

  messages        Message[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([channel, externalId])
  @@index([donorId])
  @@index([assignedToId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

// Từng tin nhắn trong cuộc hội thoại
model Message {
  id              String          @id @default(cuid())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction       MessageDirection // IN = khách gửi, OUT = staff gửi
  content         String
  contentType     MessageContentType @default(TEXT)
  attachmentUrl   String?         // Link file đính kèm nếu có

  // Người gửi (nếu là OUT)
  sentById        String?
  sentBy          User?           @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)

  externalMsgId   String?         // ID tin nhắn bên ngoài (để tránh duplicate)
  sentAt          DateTime        @default(now())
  isRead          Boolean         @default(false)

  createdAt       DateTime        @default(now())

  @@index([conversationId])
  @@index([sentAt])
  @@map("messages")
}

enum InboxChannel {
  FACEBOOK    // Facebook Messenger
  ZALO        // Zalo OA
  EMAIL       // Email
}

enum ConversationStatus {
  OPEN        // Đang mở
  RESOLVED    // Đã xử lý
  SPAM        // Spam
}

enum MessageDirection {
  IN          // Khách gửi vào
  OUT         // Staff gửi ra
}

enum MessageContentType {
  TEXT
  IMAGE
  FILE
  STICKER
}

// ================================
// WAREHOUSE MANAGEMENT (Hầm B2)
// ================================

// Mặt hàng trong kho
model WarehouseItem {
  id                String                @id @default(cuid())
  code              String                @unique  // Mã hàng (sản phẩm)
  name              String                         // Tên hàng
  unit              String                         // Đơn vị (cái, hộp, kg,...)
  category          WarehouseCategory     @default(OTHER)
  currentQuantity   Int                   @default(0)  // Tồn kho hiện tại (tổng các lô)
  minQuantity       Int                   @default(0)  // Ngưỡng cảnh báo tồn thấp
  notes             String?                          // Ghi chú tình trạng hàng

  transactions      WarehouseTransaction[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  @@index([code])
  @@index([name])
  @@index([category])
  @@map("warehouse_items")
}

enum WarehouseCategory {
  FOOD              // Thực phẩm
  MEDICINE          // Thuốc / Vật tư y tế
  GIFT              // Quà tặng
  EQUIPMENT         // Thiết bị
  OTHER             // Khác
}

// Giao dịch nhập/xuất kho
model WarehouseTransaction {
  id                String                @id @default(cuid())
  itemId            String
  item              WarehouseItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type              WarehouseTransactionType  // IMPORT | EXPORT
  quantity          Int                        // Số lượng nhập/xuất
  batchCode         String?                    // Mã lô (chỉ khi IMPORT)
  expiryDate        DateTime?                  // HSD của lô (chỉ khi IMPORT)
  expiryAlertMonths Int                   @default(1) // Cảnh báo trước N tháng
  donorUnit         String?                    // Đơn vị tài trợ
  purpose           String?                    // Mục đích tài trợ / xuất kho
  handledBy         String?                    // Người thực hiện (nhận/giao)
  transactionDate   DateTime              @default(now())
  notes             String?

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([itemId])
  @@index([type])
  @@index([transactionDate])
  @@map("warehouse_transactions")
}

enum WarehouseTransactionType {
  IMPORT            // Nhập kho
  EXPORT            // Xuất kho
}

model CustomOption {
  id        String   @id @default(cuid())
  type      String   // cash_purpose, usage_method
  label     String
  createdAt DateTime @default(now())

  @@index([type])
  @@map("custom_options")
}

// ================================
// QUẢN LÝ THUỐC ĐI TỪ THIỆN
// ================================

// Danh mục thuốc chung (Master Data)
model CharityMedicine {
  id              String                @id @default(cuid())
  code            String                @unique  // Mã thuốc
  name            String                         // Tên thuốc
  activeIngredient String?                       // Hoạt chất
  unit            String                         // Đơn vị tính (viên, hộp, chai,...)
  category        MedicineCategory      @default(OTHER)
  notes           String?

  batches         MedicineBatch[]
  demandStats     CharityDemandStat[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([code])
  @@index([name])
  @@index([category])
  @@map("charity_medicines")
}

enum MedicineCategory {
  ANTIBIOTIC        // Kháng sinh
  PAINKILLER        // Giảm đau
  DIGESTIVE         // Tiêu hóa
  RESPIRATORY       // Hô hấp
  CARDIOVASCULAR    // Tim mạch
  DERMATOLOGY       // Da liễu
  MUSCULOSKELETAL   // Cơ xương khớp
  VITAMIN           // Vitamin / Bổ sung
  EYE_ENT           // Mắt / Tai mũi họng
  DIABETES          // Tiểu đường
  ALLERGY           // Dị ứng
  OTHER             // Khác
}

// Địa điểm tổ chức khám từ thiện
model CharityLocation {
  id              String                @id @default(cuid())
  province        String                         // Tỉnh/TP
  district        String?                        // Quận/Huyện
  ward            String?                        // Phường/Xã
  epidemiology    String?                        // Đặc điểm dịch tễ (vùng núi, đồng bằng, ngập nước,...)
  notes           String?

  trips           CharityTrip[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([province])
  @@map("charity_locations")
}

// Chuyến đi từ thiện
model CharityTrip {
  id              String                @id @default(cuid())
  tripCode        String                @unique  // Mã chuyến
  locationId      String
  location        CharityLocation       @relation(fields: [locationId], references: [id])

  startDate       DateTime
  endDate         DateTime
  expectedPatients Int?                          // Số lượng người dự kiến khám
  actualPatients  Int?                           // Số thực tế (cập nhật sau chuyến)
  demographics    String?                        // Ghi chú đặc điểm dân cư (tỷ lệ già/trẻ em)
  status          CharityTripStatus     @default(PLANNING)
  notes           String?

  transactions    MedicineTransaction[]
  demandStats     CharityDemandStat[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([locationId])
  @@index([startDate])
  @@index([status])
  @@map("charity_trips")
}

enum CharityTripStatus {
  PLANNING          // Đang lên kế hoạch
  PREPARED          // Đã chuẩn bị thuốc
  IN_PROGRESS       // Đang thực hiện
  COMPLETED         // Hoàn thành
  CANCELLED         // Huỷ
}

// Lô thuốc (quản lý theo Date — cốt lõi)
model MedicineBatch {
  id              String                @id @default(cuid())
  medicineId      String
  medicine        CharityMedicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  batchCode       String?                        // Mã lô nhà sản xuất
  expiryDate      DateTime                       // Hạn sử dụng
  currentStock    Int                   @default(0)  // Tồn kho hiện tại của lô
  initialQuantity Int                   @default(0)  // Số lượng ban đầu khi nhập
  unitCost        Decimal?              @db.Decimal(15, 2)  // Đơn giá
  supplier        String?                        // Nhà cung cấp / Nguồn tài trợ
  notes           String?

  transactions    MedicineTransaction[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([medicineId])
  @@index([expiryDate])
  @@map("medicine_batches")
}

// Giao dịch thuốc (Nhập / Xuất / Thu hồi)
model MedicineTransaction {
  id              String                      @id @default(cuid())
  batchId         String
  batch           MedicineBatch               @relation(fields: [batchId], references: [id], onDelete: Cascade)

  tripId          String?                     // null nếu là nhập kho đầu vào
  trip            CharityTrip?                @relation(fields: [tripId], references: [id])

  type            MedicineTransactionType
  quantity        Int                         // Số lượng
  transactionDate DateTime                    @default(now())
  handledBy       String?                     // Người thực hiện
  notes           String?

  createdAt       DateTime                    @default(now())

  @@index([batchId])
  @@index([tripId])
  @@index([type])
  @@index([transactionDate])
  @@map("medicine_transactions")
}

enum MedicineTransactionType {
  IMPORT            // Nhập kho (mua / nhận tài trợ)
  EXPORT            // Xuất đi chuyến từ thiện
  RETURN            // Thu hồi (mang về từ chuyến đi)
  ADJUSTMENT        // Điều chỉnh (hao hụt, hư hỏng)
}

// Thống kê nhu cầu thực tế (data để train model sau này)
model CharityDemandStat {
  id              String                @id @default(cuid())
  tripId          String
  trip            CharityTrip           @relation(fields: [tripId], references: [id], onDelete: Cascade)

  medicineId      String
  medicine        CharityMedicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  quantityUsed    Int                   @default(0)  // Số lượng thực xài
  quantityShort   Int                   @default(0)  // Số lượng thiếu (nhu cầu ảo — bác sĩ kê đơn nhưng hết thuốc)
  notes           String?

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([tripId, medicineId])
  @@index([tripId])
  @@index([medicineId])
  @@map("charity_demand_stats")
}
